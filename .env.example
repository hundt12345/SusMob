# SusMob – Vorlage für .env  (kopieren nach .env, .env ist git-ignoriert)
# Wird beim Start automatisch geladen (server/envfile.py).
# Echte Umgebungsvariablen haben Vorrang vor dieser Datei (auch leere).

# Pflicht für echte Chat-Antworten (sonst Demo-Modus):
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: schützt den Admin-Bereich (#/admin)
# ADMIN_PASSWORD=geheim

# --- Betrieb / Hosting -------------------------------------------------------
# Datenverzeichnis für SQLite, Uploads und Artefakte (z. B. gemountetes Volume):
# SUSMOB_DATA_DIR=/data

# --- Schutz einer öffentlichen Test-Instanz (Gratis-Modelle!) ----------------
# Datenschutz-Banner + Audit-Eintrag: nur Demo-Daten verwenden
# SUSMOB_DEMO_ONLY=1
# Globales Tagesbudget der Modell-Aufrufe (Free-Tier: 50/Tag, ab 10 $ Guthaben 1000)
# SUSMOB_DAILY_REQUEST_BUDGET=50
# Limit pro IP und Stunde
# SUSMOB_CHAT_LIMIT_PER_HOUR=8
# Maximale Länge einer Chat-Nachricht in Zeichen
# SUSMOB_MAX_MESSAGE_CHARS=8000
