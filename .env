# SusMob – Vorlage für .env  (kopieren nach .env, .env ist git-ignoriert)
# Wird beim Start automatisch geladen (server/envfile.py).
# Echte Umgebungsvariablen haben Vorrang vor dieser Datei.

# Pflicht für echte Chat-Antworten (sonst Demo-Modus):
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: schützt den Admin-Bereich (#/admin, #/admin/system)
# ADMIN_PASSWORD=geheim

# Betriebsmodus: demo | produktion
#  demo        – Gratis-Modelle sind erlaubt (Standard, für Test-/Demodaten)
#  produktion  – Gratis-Modelle werden für Chats gesperrt (Datenschutz, AVV nötig)
# SUSMOB_MODE=demo

# Überschreibt die Gratis-Sperre im Produktionsmodus (nur für Demodaten sinnvoll)
# SUSMOB_ALLOW_FREE_FOR_DATA=0

# Optional für den Port (Docker/Plattformen setzen PORT selbst)
# PORT=8080
